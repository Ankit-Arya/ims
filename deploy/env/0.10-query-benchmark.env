# IMS 0.10 candidate query-plane benchmark profile.
# DO NOT copy to production blindly. Run the golden-set benchmark against the current profile
# and choose the fastest configuration that preserves evidence Recall@K / nDCG / citation quality.

# Optional 8-vCPU isolation profile. This requires the 0.10 Compose QUERY_CPUSET split.
# It prevents the CPU cross-encoder from contending with PostgreSQL/API on the same cores.
ONLINE_CPUSET=0-1
QUERY_CPUSET=2-5
BACKGROUND_CPUSET=6-7
QUERY_ML_NUM_THREADS=4

# Query reranker - requires rebuilding inference-query with INSTALL_OPTIMIZED_RERANK=1.
INSTALL_OPTIMIZED_RERANK=1
RERANK_BACKEND=openvino
RERANK_MAX_LENGTH=512
RERANK_PREFILTER_MAX_CANDIDATES=24
RERANK_TOP_K=12
DIRECT_RERANK_TOP_K=8

# Preserve current embedding model/dimension. Do not re-embed merely for this control-plane change.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_SEQ_LENGTH=1024

# Global recall safety + soft document routing.
GLOBAL_SAFETY_RETRIEVAL_ENABLED=true
ROUTED_DOCUMENT_BOOST_ENABLED=true
ROUTED_DOCUMENT_BOOST=1.12
ROUTED_DENSE_TOP_K=12
ROUTED_LEXICAL_TOP_K=16
ROUTED_SEARCH_MAX_QUERIES=2

# Governing-reference lane. It is always additive and can never short-circuit global retrieval.
GOVERNING_REFERENCE_ENABLED=true
GOVERNING_REFERENCE_PATTERNS=MRGR
GOVERNING_REFERENCE_DENSE_TOP_K=6
GOVERNING_REFERENCE_LEXICAL_TOP_K=8
GOVERNING_REFERENCE_EVIDENCE_K=2

# Corpus-aware terminology expansion.
CORPUS_TERM_RESOLUTION_ENABLED=true
CORPUS_TERM_MAX_QUERY_TOKENS=8
CORPUS_TERM_CANDIDATES_PER_TOKEN=3
CORPUS_TERM_SIMILARITY_THRESHOLD=0.42
CORPUS_TERM_EXPANSIONS_MAX=6
QUERY_FRAME_ENABLED=true

# Candidate diversity before the primary reranker.
LANE_RESERVATION_ENABLED=true
LANE_RESERVE_DENSE=4
LANE_RESERVE_LEXICAL=4
LANE_RESERVE_EXACT=2
LANE_RESERVE_TABLE=4
LANE_RESERVE_GOVERNING=2
LANE_RESERVE_ROUTED=2

# Start conservative. Benchmark relaxed_order separately; pgvector documents better recall but
# slightly relaxed ordering, and IMS already reranks the bounded candidate set.
HNSW_ITERATIVE_SCAN_MODE=strict_order

# One bounded repair formulation set after incomplete full-corpus evidence.
RECOVERY_MAX_QUERIES_PER_GOAL=3
