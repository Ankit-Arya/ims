# IMS / Institutional Knowledge Engine
# Copy to .env for a fresh deployment, then set OPENAI_API_KEY.
# scripts/init_env.py replaces the secret/password placeholders automatically.

APP_ENV=development
APP_NAME=IMS - Incident Management System
ORGANIZATION_NAME=Delhi Metro Rail Corporation (DMRC)
ORGANIZATION_SHORT_NAME=DMRC
APP_SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO

POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql+psycopg://knowledge:replace-with-strong-database-password@postgres:5432/knowledge
REDIS_URL=redis://valkey:6379/0
TASK_VISIBILITY_TIMEOUT_SECONDS=21600
DATA_ROOT=/data
MAX_UPLOAD_MB=200

INTERNAL_SERVICE_TOKEN=replace-with-another-long-random-value
INFERENCE_URL=http://inference-query:8090
QUERY_INFERENCE_URL=http://inference-query:8090
INGESTION_INFERENCE_URL=http://inference-ingest:8090
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
ML_DEVICE=cpu

HNSW_EF_SEARCH=100
HNSW_MAX_SCAN_TUPLES=20000
HNSW_ITERATIVE_SCAN_MODE=strict_order
RRF_K=60
RELAXED_LEXICAL_ENABLED=true
SECTION_NAVIGATION_ENABLED=true
SECTION_NAVIGATION_SCAN_MULTIPLIER=4

QUERY_MAX_ACTIVE_PER_API=4
QUERY_MAX_WAITING_PER_API=48
QUERY_DEBUG_DOWNLOAD_ENABLED=true

# v5 planned AI research. One AI plans the information need and searches;
# another AI reasons over evidence, requests at most one targeted gap round, and answers.
AGENTIC_QA_ENABLED=true
AGENTIC_QA_FALLBACK_ENABLED=false
AGENT_SEARCH_TOP_K=14
AGENT_SEARCH_MAX_TOP_K=24
AGENT_SEARCH_PREFILTER_K=28
AGENT_RERANK_ENABLED=false
AGENT_SEARCH_RERANK_CANDIDATES=80
AGENT_ENUMERATION_TOP_K=48
AGENT_ENUMERATION_MAX_TOP_K=80
AGENT_ENUMERATION_PREFILTER_K=96
AGENT_ENUMERATION_DENSE_TOP_K=32
AGENT_ENUMERATION_RERANK_CANDIDATES=80
AGENT_ENUMERATION_CONTEXT_GROUP_LIMIT=8
AGENT_DOCUMENT_SEARCH_LIMIT=12
AGENT_STRUCTURE_MAX_NODES=180
AGENT_EVIDENCE_CATALOG_LIMIT=120
AGENT_EVIDENCE_SELECTOR_ENABLED=true
AGENT_EVIDENCE_SELECTOR_MIN_CANDIDATES=8
AGENT_EVIDENCE_SELECTOR_MAX_CANDIDATES=48
AGENT_EVIDENCE_SELECTOR_EXCERPT_CHARS=1200
AGENT_EVIDENCE_SELECTOR_RESERVE=4
AGENT_EVIDENCE_SELECTOR_MAX_OUTPUT_TOKENS=1600
AGENT_EVIDENCE_SELECTOR_REASONING=low
AGENT_ANSWER_EVIDENCE_CAP=48
AGENT_SELECTED_EVIDENCE_CAP=24
AGENT_MAX_EVIDENCE=50
AGENT_RECENT_HISTORY_COUNT=6
AGENT_RECENT_HISTORY_ANSWER_CHARS=1200
AGENT_PRIMARY_RESEARCH_TIME_SECONDS=20
AGENT_GAP_RESEARCH_TIME_SECONDS=12
AGENT_MAX_GAP_TASKS=6
AGENT_PLANNER_MAX_OUTPUT_TOKENS=1800
AGENT_ANSWER_MAX_OUTPUT_TOKENS=4200
AGENT_PLANNER_REASONING=medium
AGENT_ANSWER_REASONING=medium

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_FAST_MODEL=gpt-5.6-luna
LLM_FAST_REASONING=low
LLM_STRONG_MODEL=gpt-5.6-terra
LLM_STRONG_REASONING=high
LLM_MAX_OUTPUT_TOKENS=7000
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# Corpus intelligence index used for document/section discovery.
RETRIEVAL_INTELLIGENCE_ENABLED=true
RETRIEVAL_INTELLIGENCE_DENSE_TOP_K=18
RETRIEVAL_INTELLIGENCE_LEXICAL_TOP_K=24
RETRIEVAL_INTELLIGENCE_FUSED_TOP_K=20
RETRIEVAL_INTELLIGENCE_TERMS_MAX=10
RETRIEVAL_INTELLIGENCE_FAMILY_EXPANSION_MAX_DOCUMENTS=24
RETRIEVAL_INTELLIGENCE_SECTION_CHARS=6000
RETRIEVAL_INTELLIGENCE_TERMS_PER_SECTION=12
RETRIEVAL_INTELLIGENCE_MIN_HINT_COVERAGE_RATIO=0.90
CORPUS_TERM_RESOLUTION_ENABLED=true
CORPUS_TERM_MAX_QUERY_TOKENS=8
CORPUS_TERM_CANDIDATES_PER_TOKEN=3
CORPUS_TERM_SIMILARITY_THRESHOLD=0.42
CORPUS_TERM_EXPANSIONS_MAX=6

VISUAL_EVIDENCE_ENABLED=true
VISUAL_MAX_ITEMS=2
VISUAL_NEARBY_PAGES=1
VISUAL_RENDER_DPI=130
VISUAL_CACHE_DIR_NAME=visual-cache
VISUAL_TOKEN_TTL_SECONDS=3600

CHUNK_MAX_TOKENS=500
DOCLING_OCR=true
DOCLING_OCR_LANGUAGES=eng
DOCLING_OCR_MODE=pdf_aware_layout_regions
DOCLING_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate
DOCLING_TIMEOUT_SECONDS=3600
DOCLING_ARTIFACTS_PATH=/models/docling
INGESTION_EMBEDDING_BATCH_SIZE=32
INGEST_CPU_TARGET_PERCENT=75
INGEST_WORKER_CONCURRENCY=1
INGEST_MAX_CONCURRENCY=1
INGEST_MEMORY_GB_PER_PROCESS=2.5
INGEST_MEMORY_RESERVE_GB=3.0
DOCLING_NUM_THREADS_PER_DOCUMENT=2
DOCLING_OCR_BATCH_SIZE=2
DOCLING_LAYOUT_BATCH_SIZE=2
DOCLING_TABLE_BATCH_SIZE=2

OKF_ENABLED=false
OKF_BUNDLE_DIR_NAME=okf
OKF_PROFILE_ENRICHMENT_ENABLED=true

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running
BOOTSTRAP_ADMIN_DEPARTMENT=platform

REPORT_MAX_DOCUMENTS=20
REPORT_PACK_MAX_CHARS=24000
REPORT_MAX_PACKS=120
REPORT_PARALLELISM=3
REPORT_REDUCE_BATCH_CHARS=60000
REPORT_SYNTHESIS_MAX_CHARS=120000
REPORT_REDUCE_MAX_ROUNDS=4

# Production VM defaults; docker-compose.local.yml overrides CPU allocation locally.
ONLINE_CPUSET=0-5
BACKGROUND_CPUSET=6-7
WORKER_MEMORY_LIMIT=8g
QUERY_INFERENCE_MEMORY_LIMIT=5g
